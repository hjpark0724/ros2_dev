  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <depend>v4l2_camera_cpp</depend>
  <depend>yuv_h264_encoder_cpp</depend>
  <depend>h264_mp4_recorder_cpp</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
